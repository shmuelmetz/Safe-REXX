<Figure 9: Boot-disk examples>

if REXXUTIL_loaded then do
   stat=SysFileTree(filespec,'filelist.','FSO')
   do i=1 to filespec.0
      ...
      end
   end
else do
   'DIR' filespec '/F /O > WORK_FILE'
      ...
   end

<end of Figure 9>

